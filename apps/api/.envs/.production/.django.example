# General
# ------------------------------------------------------------------------------
# DJANGO_READ_DOT_ENV_FILE=True
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=a-generer
DJANGO_ADMIN_URL=django-admin-a-generer/
DJANGO_ALLOWED_HOSTS=optiboul.local,.optiboul.cm
# Nom public du tunnel, avec https:// (ADR-19). Vide sans accès distant.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Nom public du tunnel, avec https:// (ADR-19). Vide sans accès distant.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Security
# ------------------------------------------------------------------------------
# TIP: better off using DNS, however, redirect is OK too
DJANGO_SECURE_SSL_REDIRECT=False

# Email
# ------------------------------------------------------------------------------
DJANGO_SERVER_EMAIL=

MAILGUN_API_KEY=
MAILGUN_DOMAIN=


# AWS
# ------------------------------------------------------------------------------
DJANGO_AWS_ACCESS_KEY_ID=
DJANGO_AWS_SECRET_ACCESS_KEY=
DJANGO_AWS_STORAGE_BUCKET_NAME=

# OptiBoul
# ------------------------------------------------------------------------------
# Clé AES-256 des copies cloud (32 octets en base64), à garder aussi hors du serveur :
# python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
OPTIBOUL_CLE_SAUVEGARDE=
# Passerelles SMS / WhatsApp (chemin Python d'une classe), fournisseur à choisir.
OPTIBOUL_PASSERELLE_SMS=
OPTIBOUL_PASSERELLE_WHATSAPP=
# Connexion avec Google (US-013) : identifiant OAuth du client web (console Google
# Cloud). Vide : la connexion avec Google est désactivée.
OPTIBOUL_GOOGLE_CLIENT_ID=

# django-allauth
# ------------------------------------------------------------------------------
DJANGO_ACCOUNT_ALLOW_REGISTRATION=False

# Gunicorn
# ------------------------------------------------------------------------------
WEB_CONCURRENCY=4


# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Celery
# ------------------------------------------------------------------------------

# Flower
CELERY_FLOWER_USER=a-generer
CELERY_FLOWER_PASSWORD=a-generer
