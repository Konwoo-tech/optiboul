{
  "name": "optiboul-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Application web OptiBoul : connexion, comptoir, atelier et gestion. Le profil de l'utilisateur décide des espaces visibles.",
  "packageManager": "pnpm@12.9.1",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "oxlint src e2e",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api-client": "orval --config orval.config.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:navigateurs": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@tanstack/react-query": "^5.104.5",
    "i18next": "^26.5.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.0",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "orval": "^8.43.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
