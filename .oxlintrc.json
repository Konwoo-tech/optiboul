{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "jsx-a11y"],
  "ignorePatterns": ["**/dist/**", "**/generated/**"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/apps/**", "@optiboul/web"],
            "message": "Les paquets n'importent jamais une application : le code commun va dans packages/ (spécification technique §3.2)."
          }
        ]
      }
    ]
  }
}
