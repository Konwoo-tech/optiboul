{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "jsx-a11y"],
  "ignorePatterns": ["**/dist/**", "**/generated/**", "**/.expo/**"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/apps/**", "@optiboul/web", "@optiboul/pilotage"],
            "message": "Une application n'importe jamais une autre application : passer par packages/ (spécification technique §3.2)."
          }
        ]
      }
    ]
  }
}
