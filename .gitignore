# Les dépendances et builds de chaque application sont ignorés dans apps/api/.gitignore et apps/web/.gitignore.

# Environnements et secrets
.env
.env.*
!.env.example
*.pem

# Outils
.ruff_cache/
__pycache__/

# Éditeurs et système
.DS_Store
.idea/
*.log

# graphify : seuls le graphe et son rapport sont partagés.
# Le cache, le manifeste et les chemins d'interpréteur dépendent de chaque poste ;
# graph.html pèse 1,8 Mo et se régénère par `graphify export html`.
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
