{
  "name": "optiboul",
  "version": "0.1.0",
  "private": true,
  "description": "OptiBoul ERP - Boulangerie du Faubourg (Etoudi, Yaoundé)",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=./apps/* --filter=!@optiboul/pilotage",
    "dev:mobile": "pnpm --filter @optiboul/pilotage start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @optiboul/e2e e2e",
    "api-client": "pnpm --filter @optiboul/api-client generate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9"
  }
}
